#!/usr/bin/env bash
# Host wrapper for bench.mjs. Copies the harness into a sibling Docker
# container on the Ollama container's network, runs it there, syncs the
# baseline back to the host.
#
# Configuration via env vars:
#   OLLAMA_BENCH_CONTAINER          Sibling container name. Auto-detected
#                                   from topology when unset (unique
#                                   container on Ollama's network with
#                                   `node` on PATH). Falls back to known
#                                   names then prefix match.
#   OLLAMA_BENCH_OLLAMA_CONTAINER   Ollama container name. Default: "ollama".
#   OLLAMA_BENCH_REMOTE_DIR         Writable path in the sibling for scripts
#                                   and the in-container baseline. Default: /tmp.
#   OLLAMA_BENCH_MACHINE_ID         Machine fingerprint seed. Auto-populated
#                                   from /etc/machine-id (or
#                                   /var/lib/dbus/machine-id).
#   OLLAMA_BENCH_TIMEOUT_MS         Per-call request timeout, forwarded to
#                                   the harness.
#
# Host-side data forwarded to the sibling:
#   OLLAMA_BENCH_GPU_CSV / _GPU_EXT_CSV   nvidia-smi --query-gpu output
#   OLLAMA_BENCH_SERVER_ENV_JSON          docker inspect ollama --format ...Env
#   OLLAMA_BENCH_CPU_GOVERNOR             /sys cpufreq scaling_governor
#   OLLAMA_BENCH_SWAP                     free -m Swap row
#   OLLAMA_BENCH_PERSISTENCED             systemctl is-active nvidia-persistenced
#
# Usage: same as `node bench.mjs`. All arguments pass through.
#   ./bench                            # smart perf run for current --model
#   ./bench rank --model nemotron3:33b # add or refresh a model in the league
#   ./bench league                     # ranked table across all benched models
#   ./bench doctor                     # preflight system audit
#   ./bench --help                     # full CLI

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
BASELINE_HOST="$HERE/baseline.json"

OLLAMA_CONTAINER="${OLLAMA_BENCH_OLLAMA_CONTAINER:-ollama}"
CONTAINER="${OLLAMA_BENCH_CONTAINER:-}"

# Helper: does $1 name a running container that has `node` on PATH?
container_has_node() {
  docker exec "$1" sh -c 'command -v node >/dev/null 2>&1' >/dev/null 2>&1
}

# Topology-based detection: any sibling on the Ollama container's network with
# Node on PATH is a valid runner. This works regardless of naming (bench,
# openclaw, foo-runner-1) and survives container renames.
if [[ -z "$CONTAINER" ]] \
  && docker ps --filter "name=^${OLLAMA_CONTAINER}$" --format '{{.Names}}' 2>/dev/null \
     | grep -qx "$OLLAMA_CONTAINER"; then
  declare -A SEEN=()
  CANDIDATES=()
  while IFS= read -r net; do
    [[ -z "$net" ]] && continue
    # `host`/`none`/`bridge` would enumerate unrelated containers; only the
    # user-defined network gives us a real "sibling on Ollama's network" set.
    [[ "$net" == "host" || "$net" == "none" || "$net" == "bridge" ]] && continue
    while IFS= read -r name; do
      [[ -z "$name" ]] && continue
      [[ "$name" == "$OLLAMA_CONTAINER" ]] && continue
      [[ -n "${SEEN[$name]:-}" ]] && continue
      SEEN[$name]=1
      # Must be running (network inspect can list stopped containers too).
      docker ps --filter "name=^${name}$" --format '{{.Names}}' \
        | grep -qx "$name" || continue
      container_has_node "$name" || continue
      CANDIDATES+=("$name")
    done < <(docker network inspect "$net" --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null)
  done < <(docker inspect "$OLLAMA_CONTAINER" --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null)

  if (( ${#CANDIDATES[@]} == 1 )); then
    CONTAINER="${CANDIDATES[0]}"
  elif (( ${#CANDIDATES[@]} > 1 )); then
    # Sort for deterministic output across runs (docker iterates in map order).
    mapfile -t CANDIDATES < <(printf '%s\n' "${CANDIDATES[@]}" | sort)
    echo "multiple sibling containers on ${OLLAMA_CONTAINER}'s network with node installed:" >&2
    printf '  %s\n' "${CANDIDATES[@]}" >&2
    echo "set OLLAMA_BENCH_CONTAINER=<name> to disambiguate" >&2
    exit 1
  fi
fi

# Known-name fallback — used when topology probing turned up nothing (e.g. the
# Ollama container isn't running, or docker network inspect isn't permitted).
if [[ -z "$CONTAINER" ]]; then
  for candidate in bench openclaw engine-openclaw-1; do
    if docker ps --filter "name=^${candidate}$" --format '{{.Names}}' | grep -qx "$candidate"; then
      CONTAINER="$candidate"; break
    fi
  done
fi
# Prefix fallback — matches openclaw-<hash>, engine-openclaw-*, bench-*, etc.
# Ambiguity (multiple running containers under the same prefix) is a user
# decision, so bail out rather than silently picking one.
if [[ -z "$CONTAINER" ]]; then
  for prefix in bench openclaw engine-openclaw; do
    mapfile -t matches < <(docker ps --filter "name=^${prefix}" --format '{{.Names}}')
    if (( ${#matches[@]} == 1 )); then
      CONTAINER="${matches[0]}"; break
    elif (( ${#matches[@]} > 1 )); then
      echo "multiple containers match '${prefix}*': ${matches[*]}" >&2
      echo "set OLLAMA_BENCH_CONTAINER=<name> to disambiguate" >&2
      exit 1
    fi
  done
fi
if [[ -z "$CONTAINER" ]]; then
  echo "no sibling container found; set OLLAMA_BENCH_CONTAINER=<name>" >&2
  exit 1
fi
if ! docker ps --filter "name=^${CONTAINER}$" --format '{{.Names}}' | grep -qx "$CONTAINER"; then
  echo "container '$CONTAINER' is not running" >&2
  exit 1
fi

REMOTE_DIR="${OLLAMA_BENCH_REMOTE_DIR:-/tmp}"
REMOTE_BASELINE="$REMOTE_DIR/ollama-bench-baseline.json"

# The unified CLI spawns the probe scripts as siblings, and several modules
# import shared helpers (bench-baseline, bench-tools), so all files must
# live next to each other in the container. Fail fast if any are missing.
SCRIPTS=(
  bench.mjs
  bench-toolcall.mjs bench-multiturn.mjs bench-tools.mjs
  bench-math.mjs bench-code.mjs bench-knowledge.mjs bench-ifeval.mjs
  bench-data.mjs bench-agent.mjs
  bench-doctor.mjs bench-baseline.mjs bench-gpu.mjs
)
# Capability probes load their case sets from data/*.jsonl, vendored in the
# repo. Copy each file individually under data/ in the remote dir.
DATA_FILES=(gsm8k.jsonl math500.jsonl humaneval.jsonl mmlupro.jsonl ifeval.jsonl wtq.jsonl wikisql.jsonl)
MISSING=()
for script in "${SCRIPTS[@]}"; do
  [[ -f "$HERE/$script" ]] || MISSING+=("$script")
done
for df in "${DATA_FILES[@]}"; do
  [[ -f "$HERE/data/$df" ]] || MISSING+=("data/$df")
done
if (( ${#MISSING[@]} > 0 )); then
  echo "missing harness files next to wrapper: ${MISSING[*]}" >&2
  echo "  (regenerate data with: node scripts/fetch-data.mjs)" >&2
  exit 2
fi
for script in "${SCRIPTS[@]}"; do
  # Pass the destination path via env so the inner shell sees a quoted
  # variable instead of an interpolated string — robust against REMOTE_DIR
  # values that contain spaces or shell metacharacters.
  docker exec -i -e DST="$REMOTE_DIR/$script" "$CONTAINER" sh -c 'cat > "$DST"' < "$HERE/$script"
done
# Ensure remote data dir exists, then copy each data file in.
docker exec -e DST="$REMOTE_DIR/data" "$CONTAINER" sh -c 'mkdir -p "$DST"'
for df in "${DATA_FILES[@]}"; do
  docker exec -i -e DST="$REMOTE_DIR/data/$df" "$CONTAINER" sh -c 'cat > "$DST"' < "$HERE/data/$df"
done

# Stable machine fingerprint — read the host's machine-id and pass it in.
# Without this, machineId hashes the container's hostname (= container id),
# which changes on every recreate and invalidates the baseline.
HOST_MACHINE_ID=""
for f in /etc/machine-id /var/lib/dbus/machine-id; do
  if [[ -r "$f" ]]; then HOST_MACHINE_ID=$(cat "$f" 2>/dev/null || true); break; fi
done

# Env snapshot — the sibling container typically has neither nvidia-smi on
# PATH nor access to the Docker socket, so bench.mjs's in-container probes
# for GPU state and OLLAMA_* server env come back empty. Run them on the
# host and forward via env vars; bench.mjs prefers injected data over its
# own local commands.
HOST_NVIDIA_SMI=""
HOST_NVIDIA_SMI_EXT=""
if command -v nvidia-smi >/dev/null 2>&1; then
  HOST_NVIDIA_SMI=$(nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used,utilization.gpu,temperature.gpu,power.draw,clocks.current.sm --format=csv,noheader,nounits 2>/dev/null) || HOST_NVIDIA_SMI=""
  # Extended field set consumed by bench-doctor.mjs (GPU_FIELDS there must match).
  HOST_NVIDIA_SMI_EXT=$(nvidia-smi --query-gpu=name,driver_version,persistence_mode,power.default_limit,power.max_limit,clocks_throttle_reasons.active --format=csv,noheader,nounits 2>/dev/null) || HOST_NVIDIA_SMI_EXT=""
fi

# Host-only probes for bench-doctor. The sibling container can't read the
# host's sysfs or /proc, so snapshot on the host and forward via env.
HOST_CPU_GOVERNOR=""
if ls /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1; then
  HOST_CPU_GOVERNOR=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null || true)
fi
HOST_SWAP=""
if command -v free >/dev/null 2>&1; then
  HOST_SWAP=$(free -m | awk '/^Swap:/ {print $2, $3}' 2>/dev/null || true)
fi
# Modern systems keep the driver resident via the nvidia-persistenced daemon
# rather than the deprecated `nvidia-smi -pm 1` flag, so nvidia-smi still
# reports persistence_mode=Disabled. Capture daemon state separately.
HOST_PERSISTENCED=""
if command -v systemctl >/dev/null 2>&1; then
  HOST_PERSISTENCED=$(systemctl is-active nvidia-persistenced 2>/dev/null || true)
fi

HOST_OLLAMA_ENV=""
if docker ps --filter "name=^${OLLAMA_CONTAINER}$" --format '{{.Names}}' 2>/dev/null | grep -qx "$OLLAMA_CONTAINER"; then
  HOST_OLLAMA_ENV=$(docker inspect "$OLLAMA_CONTAINER" --format '{{json .Config.Env}}' 2>/dev/null) || HOST_OLLAMA_ENV=""
fi

# Seed baseline from host if we have one. Capture content hash so we can
# detect mutation after the run without being fooled by mtime bumps from
# the copy-in itself. Hash failures (md5sum missing) leave PRE_HASH empty,
# which forces a sync-back at the end (safer to over-copy than skip a real
# change).
if [[ -f "$BASELINE_HOST" ]]; then
  docker exec -i -e DST="$REMOTE_BASELINE" "$CONTAINER" sh -c 'cat > "$DST"' < "$BASELINE_HOST"
  PRE_HASH=$(md5sum "$BASELINE_HOST" 2>/dev/null | cut -d' ' -f1 || true)
else
  docker exec "$CONTAINER" rm -f "$REMOTE_BASELINE"
  PRE_HASH=""
fi

# Inject --out so the script points at the in-container baseline path.
# (User-supplied --out would be a host path and wouldn't exist inside the container.)
EXEC_ENV=()
if [[ -n "$HOST_MACHINE_ID" ]]; then
  EXEC_ENV+=(-e "OLLAMA_BENCH_MACHINE_ID=$HOST_MACHINE_ID")
fi
# Export + `-e KEY` (no value) is the robust form for multi-line / JSON
# payloads: docker forwards the variable from the wrapper's environment
# rather than trying to parse it as a KEY=VAL argument.
if [[ -n "$HOST_NVIDIA_SMI" ]]; then
  export OLLAMA_BENCH_GPU_CSV="$HOST_NVIDIA_SMI"
  EXEC_ENV+=(-e OLLAMA_BENCH_GPU_CSV)
fi
if [[ -n "$HOST_NVIDIA_SMI_EXT" ]]; then
  export OLLAMA_BENCH_GPU_EXT_CSV="$HOST_NVIDIA_SMI_EXT"
  EXEC_ENV+=(-e OLLAMA_BENCH_GPU_EXT_CSV)
fi
if [[ -n "$HOST_OLLAMA_ENV" ]]; then
  export OLLAMA_BENCH_SERVER_ENV_JSON="$HOST_OLLAMA_ENV"
  EXEC_ENV+=(-e OLLAMA_BENCH_SERVER_ENV_JSON)
fi
if [[ -n "$HOST_CPU_GOVERNOR" ]]; then
  export OLLAMA_BENCH_CPU_GOVERNOR="$HOST_CPU_GOVERNOR"
  EXEC_ENV+=(-e OLLAMA_BENCH_CPU_GOVERNOR)
fi
if [[ -n "$HOST_SWAP" ]]; then
  export OLLAMA_BENCH_SWAP="$HOST_SWAP"
  EXEC_ENV+=(-e OLLAMA_BENCH_SWAP)
fi
if [[ -n "$HOST_PERSISTENCED" ]]; then
  export OLLAMA_BENCH_PERSISTENCED="$HOST_PERSISTENCED"
  EXEC_ENV+=(-e OLLAMA_BENCH_PERSISTENCED)
fi
# Per-call request timeout — documented at the top of this file as
# "forwarded to the harness" but previously not actually forwarded.
if [[ -n "${OLLAMA_BENCH_TIMEOUT_MS:-}" ]]; then
  EXEC_ENV+=(-e "OLLAMA_BENCH_TIMEOUT_MS=$OLLAMA_BENCH_TIMEOUT_MS")
fi
set +e
docker exec "${EXEC_ENV[@]}" "$CONTAINER" node "$REMOTE_DIR/bench.mjs" "$@" --out "$REMOTE_BASELINE"
EXIT=$?
set -e

# Sync baseline state back to host only if the run actually changed it.
# Empty POST_HASH (md5sum missing in container) is treated as "changed" so
# we copy back rather than silently skip. Write goes to a temp file and is
# renamed on success — if the wrapper is interrupted mid-copy, the existing
# host baseline is preserved instead of being half-written.
if [[ $EXIT -eq 0 ]]; then
  if docker exec "$CONTAINER" test -f "$REMOTE_BASELINE"; then
    POST_HASH=$(docker exec "$CONTAINER" md5sum "$REMOTE_BASELINE" 2>/dev/null | cut -d' ' -f1 || true)
    if [[ -z "$POST_HASH" || "$POST_HASH" != "$PRE_HASH" ]]; then
      TMP="$BASELINE_HOST.tmp.$$"
      if docker exec "$CONTAINER" cat "$REMOTE_BASELINE" > "$TMP"; then
        mv -f "$TMP" "$BASELINE_HOST"
        echo "host baseline: $BASELINE_HOST"
      else
        rm -f "$TMP"
        echo "warning: failed to copy baseline back from container" >&2
      fi
    fi
  elif [[ -n "$PRE_HASH" ]]; then
    rm -f "$BASELINE_HOST"
    echo "host baseline cleared: $BASELINE_HOST"
  fi
fi

exit $EXIT
